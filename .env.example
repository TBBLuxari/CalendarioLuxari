# Copia este archivo a ".env" y completa los valores. En producción (Render)
# estas mismas claves se configuran como variables de entorno del servicio,
# no en un archivo.

# Base de datos. En desarrollo local puedes dejar la de archivo (no necesitas
# cuenta en Turso todavía). En producción, usa la URL/token que te da Turso.
DATABASE_URL=file:./server/data/local.db
DATABASE_AUTH_TOKEN=

# Firma de las sesiones (cookie). Pon cualquier cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Contraseñas de cada rol. Si dejas una vacía, ese rol queda deshabilitado
# (nadie puede entrar con él). Se hashean con bcrypt al arrancar el servidor;
# nunca quedan en texto plano en la base de datos ni en el código.
OWNER_PASSWORD=
GUEST_PASSWORD=
BOOKING_PASSWORD=

PORT=3000
